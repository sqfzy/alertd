[runtime]
host = "production-host"
ip = "203.0.113.10"
interval = "5s"
state_dir = "/var/lib/alertd-live-mm"
log_level = "info"
command_timeout = "3s"

[alarm]
pending_for = "10s"
recover_for = "10s"
warn_repeat = "30m"
critical_repeat = "10m"
daily_report_at = "off"
collect_fail_after_n = 3

[delivery]
timeout = "3s"
queue_capacity = 1024
queue_warn_pct = 80
failure_report_after = 3
retry_initial = "5s"
retry_max = "5m"

[[delivery.routes]]
name = "default"
token_env = "ALERTD_LIVE_MM_DINGTALK_TOKEN"
at_all_on_critical = false

[[checks]]
name = "live-mm-health"
severity = "critical"
type = "observation_file"
path = "/run/live-mm-observer/health.json"
stale_after = "30s"

[[checks]]
name = "live-mm-statistics"
type = "observation_file"
path = "/run/live-mm-observer/statistics.json"
stale_after = "90s"
forward_report = true
pending_for = "24h"
