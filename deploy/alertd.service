[Unit]
Description=alertd host and application alert daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90s
ExecStart=/usr/local/bin/alertd --config /etc/alertd/alertd.toml
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=/etc/alertd/alertd.env
StateDirectory=alertd
CPUAffinity=0
Nice=10
Restart=always
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alertd

[Install]
WantedBy=multi-user.target
